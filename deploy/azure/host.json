{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string", "defaultValue": "swedencentral" },
    "vmSize": { "type": "string", "defaultValue": "Standard_B2pts_v2", "allowedValues": ["Standard_B2ats_v2", "Standard_B1s", "Standard_B2pts_v2"] },
    "sshPublicKey": { "type": "string", "minLength": 40 },
    "adminSourceCidr": { "type": "string", "minLength": 9 },
    "cloudInit": { "type": "string" }
  },
  "variables": { "prefix": "trobot" },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups", "apiVersion": "2024-05-01",
      "name": "trobot-nsg", "location": "[parameters('location')]",
      "properties": { "securityRules": [
        { "name": "AdminSSH", "properties": { "priority": 100, "direction": "Inbound", "access": "Allow", "protocol": "Tcp", "sourcePortRange": "*", "destinationPortRange": "22", "sourceAddressPrefix": "[parameters('adminSourceCidr')]", "destinationAddressPrefix": "*" } },
        { "name": "PublicHTTP", "properties": { "priority": 110, "direction": "Inbound", "access": "Allow", "protocol": "Tcp", "sourcePortRange": "*", "destinationPortRanges": ["80", "443"], "sourceAddressPrefix": "Internet", "destinationAddressPrefix": "*" } }
      ] }
    },
    {
      "type": "Microsoft.Network/virtualNetworks", "apiVersion": "2024-05-01",
      "name": "trobot-vnet", "location": "[parameters('location')]",
      "properties": { "addressSpace": { "addressPrefixes": ["10.71.0.0/16"] }, "subnets": [
        { "name": "app", "properties": { "addressPrefix": "10.71.1.0/24", "defaultOutboundAccess": false } }
      ] }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses", "apiVersion": "2024-05-01",
      "name": "trobot-ip", "location": "[parameters('location')]",
      "sku": { "name": "Standard", "tier": "Regional" },
      "properties": { "publicIPAllocationMethod": "Static", "publicIPAddressVersion": "IPv4" }
    },
    {
      "type": "Microsoft.Network/networkInterfaces", "apiVersion": "2024-05-01",
      "name": "trobot-nic", "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Network/virtualNetworks','trobot-vnet')]", "[resourceId('Microsoft.Network/networkSecurityGroups','trobot-nsg')]", "[resourceId('Microsoft.Network/publicIPAddresses','trobot-ip')]"],
      "properties": {
        "networkSecurityGroup": { "id": "[resourceId('Microsoft.Network/networkSecurityGroups','trobot-nsg')]" },
        "ipConfigurations": [{ "name": "primary", "properties": { "privateIPAllocationMethod": "Dynamic", "subnet": { "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets','trobot-vnet','app')]" }, "publicIPAddress": { "id": "[resourceId('Microsoft.Network/publicIPAddresses','trobot-ip')]" } } }]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines", "apiVersion": "2024-07-01",
      "name": "trobot-vm", "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Network/networkInterfaces','trobot-nic')]"],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "storageProfile": {
          "imageReference": { "publisher": "Canonical", "offer": "ubuntu-24_04-lts", "sku": "[if(equals(parameters('vmSize'), 'Standard_B2pts_v2'), 'server-arm64', 'server')]", "version": "latest" },
          "osDisk": { "name": "trobot-os", "createOption": "FromImage", "diskSizeGB": 64, "managedDisk": { "storageAccountType": "Premium_LRS" }, "deleteOption": "Detach" }
        },
        "osProfile": {
          "computerName": "trobot-azure", "adminUsername": "trobotadmin",
          "customData": "[parameters('cloudInit')]",
          "linuxConfiguration": { "disablePasswordAuthentication": true, "provisionVMAgent": true, "ssh": { "publicKeys": [{ "path": "/home/trobotadmin/.ssh/authorized_keys", "keyData": "[parameters('sshPublicKey')]" }] } }
        },
        "networkProfile": { "networkInterfaces": [{ "id": "[resourceId('Microsoft.Network/networkInterfaces','trobot-nic')]", "properties": { "deleteOption": "Detach" } }] },
        "diagnosticsProfile": { "bootDiagnostics": { "enabled": true } }
      }
    }
  ],
  "outputs": {
    "publicIp": { "type": "string", "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses','trobot-ip')).ipAddress]" }
  }
}

@model DashboardViewModel
@inject TRobot.Web.Security.PortalModules PortalModules
@{
    ViewData["Title"] = "Presenze";
}
<div class="page-heading">
    <div><h1>Presenze</h1><p class="page-intro">Il punto di partenza per organizzare il tuo evento.</p></div>
</div>
@if (TempData["Notice"] is string notice)
{
    <div class="alert alert-success" role="status" style="white-space: pre-line">@notice</div>
}
@if (Model.Dashboard is not { } dashboard)
{
    <section class="empty-state">
        <h2 class="h4">Da qui comincia l'organizzazione</h2>
        <p>Nessun evento assegnato a questo organizzatore. Apri l'elenco eventi per creare un evento, se autorizzato, oppure chiedi un'assegnazione all'amministratore.</p>
        <a class="btn btn-primary" asp-controller="Events" asp-action="Index">Vai agli eventi</a>
    </section>
}
else
{
    @if (Model.Events.Count > 1)
    {
    <form asp-action="Index" method="get" class="event-switcher">
        <label for="eventId" class="form-label">Evento</label>
        <select id="eventId" name="eventId" class="form-select">
            @foreach (var ev in Model.Events)
            {
                <option value="@ev.Id" selected="@(ev.Id == dashboard.EventId)">@ev.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-secondary mt-2">Mostra presenze</button>
    </form>
    }
    <p class="current-event">Evento: <strong>@dashboard.EventName</strong></p>
    <partial name="_EventNavigation" model="dashboard.EventId" />
    <dl class="row border rounded py-3 my-3" aria-label="Conteggi presenze">
        <div class="col"><dt>Confermati</dt><dd id="confirmed-count">@dashboard.Confirmed</dd></div>
        <div class="col"><dt>Indecisi</dt><dd id="undecided-count">@dashboard.Undecided</dd></div>
        <div class="col"><dt>Assenti</dt><dd id="absent-count">@dashboard.Absent</dd></div>
        <div class="col"><dt>Senza risposta</dt><dd id="no-response-count">@dashboard.NoResponse</dd></div>
        <div class="col"><dt>Totale persone</dt><dd id="total-count">@dashboard.Total</dd></div>
    </dl>
    <nav class="quick-actions" aria-label="Azioni per organizzare l'evento">
        <a class="btn btn-primary" asp-controller="Events" asp-action="Details" asp-route-id="@dashboard.EventId" asp-fragment="participants">Gestisci partecipanti</a>
        <a class="btn btn-outline-primary" asp-controller="Stays" asp-action="Index" asp-route-eventId="@dashboard.EventId">Controlla i soggiorni</a>
        <a class="btn btn-outline-primary" asp-controller="Lodging" asp-action="Index" asp-route-eventId="@dashboard.EventId">Organizza gli alloggi</a>
    </nav>
    @if (Model.LocalOverview is { } overview)
    {
        ViewData["OverviewEventId"] = dashboard.EventId;
        <partial name="_LocalOverview" model="overview" />
    }
    <section class="event-facts" aria-labelledby="event-program-title">
        <h2 id="event-program-title" class="h4">Luogo e programma</h2>
        <p><strong>Luogo:</strong> @(dashboard.Location ?? "Da definire")</p>
        <p style="white-space: pre-wrap">@(dashboard.Program ?? "Programma da definire. Puoi aggiungerlo nella pagina Evento e partecipanti.")</p>
    </section>
    @if (PortalModules.IsEnabled(TRobot.Web.Security.PortalModule.Simulator))
    {
    <details class="simulation-panel" open="@(!ViewData.ModelState.IsValid)">
    <summary>Simulatore di messaggi</summary>
    <h2 class="h4">Simula un messaggio</h2>
    <p class="text-muted">Questo simulatore non invia messaggi WhatsApp.</p>
    <p>@PortalModules.SimulatorHelp</p>
    <form asp-action="Simulate" method="post" class="col-lg-7">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="Input.EventId" type="hidden" />
        <label asp-for="Input.SenderId" class="form-label">Mittente simulato</label>
        <select asp-for="Input.SenderId" class="form-select mb-3">
            @foreach (var sender in dashboard.Senders)
            {
                <option value="@sender.SenderId">@sender.DisplayName</option>
            }
        </select>
        <label asp-for="Input.Text" class="form-label">Messaggio</label>
        <input asp-for="Input.Text" class="form-control mb-3" required maxlength="100" />
        <label asp-for="Input.MessageId" class="form-label">Identificativo del messaggio</label>
        <input asp-for="Input.MessageId" class="form-control" required maxlength="100" />
        <p class="form-text">Reinvia lo stesso identificativo per verificare che il messaggio venga elaborato una sola volta.</p>
        <div class="form-check mb-3">
            <input asp-for="Input.ConfirmVote" class="form-check-input" />
            <label asp-for="Input.ConfirmVote" class="form-check-label">Confermo l'operazione indicata nel messaggio per il mittente selezionato (voto, risposta definitiva o impegno).</label>
        </div>
        <button type="submit" class="btn btn-primary" disabled="@(dashboard.Senders.Count == 0)">Elabora messaggio simulato</button>
    </form>
    </details>
    }
}

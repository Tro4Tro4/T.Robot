@model ChangePasswordInput
@{ ViewData["Title"] = "Cambia password"; }
<h1>Cambia password</h1>
<p>Usa almeno 12 caratteri con maiuscole, minuscole, cifre e simboli.</p>
<form asp-action="ChangePassword" method="post" class="col-lg-6">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <label asp-for="CurrentPassword" class="form-label">Password attuale</label>
    <input asp-for="CurrentPassword" autocomplete="current-password" class="form-control mb-3" required maxlength="128" />
    <label asp-for="NewPassword" class="form-label">Nuova password</label>
    <input asp-for="NewPassword" autocomplete="new-password" class="form-control mb-3" required minlength="12" maxlength="128" />
    <label asp-for="ConfirmPassword" class="form-label">Ripeti la nuova password</label>
    <input asp-for="ConfirmPassword" autocomplete="new-password" class="form-control mb-3" required maxlength="128" />
    <button class="btn btn-primary" type="submit">Aggiorna password</button>
</form>

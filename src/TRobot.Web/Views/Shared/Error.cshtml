@model ErrorViewModel
@{
    ViewData["Title"] = "Errore";
}
<h1 class="text-danger">Operazione non completata</h1>
<p>Si è verificato un errore. Riprova; per una simulazione usa lo stesso identificativo del messaggio.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Riferimento errore:</strong> <code>@Model.RequestId</code>
    </p>
}

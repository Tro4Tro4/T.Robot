@model Guid
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string? Current(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<nav aria-label="Moduli evento" class="event-navigation">
    <a asp-controller="Home" aria-current="@Current("Home")" asp-action="Index" asp-route-eventId="@Model">Dashboard e presenze</a>
    <a asp-controller="Events" aria-current="@Current("Events")" asp-action="Details" asp-route-id="@Model">Evento e partecipanti</a>
    <a asp-controller="Households" aria-current="@Current("Households")" asp-action="Index" asp-route-eventId="@Model">Nuclei</a>
    <a asp-controller="Tasks" aria-current="@Current("Tasks")" asp-action="Index" asp-route-eventId="@Model">Attività</a>
    <a asp-controller="Menu" aria-current="@Current("Menu")" asp-action="Index" asp-route-eventId="@Model">Menu</a>
    <a asp-controller="Polls" aria-current="@Current("Polls")" asp-action="Index" asp-route-eventId="@Model">Sondaggi</a>
    <a asp-controller="Accounting" aria-current="@Current("Accounting")" asp-action="Index" asp-route-eventId="@Model">Contabilità</a>
    <a asp-controller="Games" aria-current="@Current("Games")" asp-action="Index" asp-route-eventId="@Model">Giochi volontari</a>
    <a asp-controller="Messages" aria-current="@Current("Messages")" asp-action="Index" asp-route-eventId="@Model">Messaggi e configurazione</a>
    <a asp-controller="WhatsApp" aria-current="@Current("WhatsApp")" asp-action="Index" asp-route-eventId="@Model">WhatsApp</a>
    <a asp-controller="History" aria-current="@Current("History")" asp-action="Index" asp-route-eventId="@Model">Storico</a>
</nav>

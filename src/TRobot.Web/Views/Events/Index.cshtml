@model EventsViewModel
@{ ViewData["Title"] = "Eventi"; }
<div class="page-heading">
<div><h1>Eventi</h1><p class="page-intro">Scegli un evento per gestire partecipanti, soggiorni e organizzazione.</p></div>
@if (Model.CanCreate)
{
    <a asp-action="Create" class="btn btn-primary">Crea evento</a>
}
</div>
@if (Model.Events.Count == 0)
{
    <section class="empty-state">
        <h2 class="h4">Non ci sono ancora eventi da gestire</h2>
        <p>Nessun evento assegnato a questo organizzatore.</p>
        <p>@(Model.CanCreate ? "Usa Crea evento per iniziare: potrai poi aggiungere i partecipanti e organizzare il soggiorno." : "Chiedi all'amministratore di assegnarti un evento. Dopo l'assegnazione lo troverai qui.")</p>
    </section>
}
else
{
    <ul class="event-list">
    @foreach (var ev in Model.Events)
    {
        <li><a asp-action="Details" asp-route-id="@ev.Id"><strong>@ev.Name</strong><span>Apri evento e partecipanti</span></a></li>
    }
    </ul>
}

@model EventDetailsViewModel
@using TRobot.Domain
@{ ViewData["Title"] = Model.Details.Event.Name; }
<h1>@Model.Details.Event.Name</h1>
<p><a asp-controller="History" asp-action="Index" asp-route-eventId="@Model.Details.Event.Id">Storico evento</a></p>
@if (TempData["EventNotice"] is string notice)
{
    <div class="alert alert-success" role="status">@notice</div>
}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<p><a asp-controller="Home" asp-action="Index" asp-route-eventId="@Model.Details.Event.Id">Presenze e simulatore</a> · <a asp-action="Index">Tutti gli eventi assegnati</a></p>
<h2 class="h4">Dati evento</h2>
<form asp-action="Update" asp-route-id="@Model.Details.Event.Id" method="post" class="col-lg-7 mb-5">
    <input asp-for="Input.Revision" type="hidden" />
    <partial name="_EventFields" for="Input" />
    <button type="submit" class="btn btn-primary">Salva evento</button>
    <a asp-action="Details" asp-route-id="@Model.Details.Event.Id" class="btn btn-link">Ricarica dati salvati</a>
</form>
<h2 class="h4">Partecipanti (@Model.Details.Participants.Count)</h2>
@if (Model.Details.Participants.Count == 0)
{
    <p>Non ci sono ancora partecipanti.</p>
}
else
{
    <table class="table">
        <thead><tr><th scope="col">Nome</th><th scope="col">Presenza</th><th scope="col">Nel simulatore</th><th scope="col">Anagrafica</th></tr></thead>
        <tbody>
        @foreach (var participant in Model.Details.Participants)
        {
            var status = participant.Status switch
            {
                ParticipationStatus.Confirmed => "Confermato",
                ParticipationStatus.Undecided => "Indeciso",
                ParticipationStatus.Absent => "Assente",
                _ => "Senza risposta"
            };
            <tr><td>@participant.DisplayName</td><td>@status</td><td>@(participant.HasSimulationSender ? "Sì" : "No")</td><td>
                <a asp-controller="Attendance" asp-action="Edit" asp-route-eventId="@Model.Details.Event.Id" asp-route-personId="@participant.PersonId" aria-label="Registra presenza di @participant.DisplayName">Registra presenza</a>
                @if (participant.CanRename)
                {
                    <a asp-action="EditParticipant" asp-route-id="@Model.Details.Event.Id" asp-route-personId="@participant.PersonId" aria-label="Correggi nome di @participant.DisplayName">Correggi nome</a>
                }
                else
                {
                    <span class="text-muted">Correzione non disponibile con questi permessi</span>
                }
            </td></tr>
        }
        </tbody>
    </table>
}
<h2 class="h4 mt-4">Aggiungi partecipante</h2>
<p>Una persona per registrazione, con stato iniziale Senza risposta. Non viene creato un account di accesso al sito.</p>
<form asp-action="AddParticipant" asp-route-id="@Model.Details.Event.Id" method="post" class="col-lg-7">
    <input asp-for="Participant.OperationId" type="hidden" />
    <label asp-for="Participant.DisplayName" class="form-label">Nome visualizzato</label>
    <input asp-for="Participant.DisplayName" class="form-control mb-3" required maxlength="150" />
    <div class="form-check mb-3">
        <input asp-for="Participant.EnableSimulation" class="form-check-input" />
        <label asp-for="Participant.EnableSimulation" class="form-check-label">Abilita nel simulatore locale</label>
    </div>
    <p class="form-text">Il simulatore usa un identificativo sintetico generato automaticamente. Non inserire numeri telefonici. Ogni nuova registrazione crea una persona distinta: usa nomi distinguibili in caso di omonimia.</p>
    <button type="submit" class="btn btn-primary">Aggiungi partecipante</button>
</form>

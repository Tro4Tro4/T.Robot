@model TRobot.Application.WhatsApp.AttendanceOverview
@using TRobot.Domain
@{ ViewData["Title"] = "Soggiorni"; }
<h1>Soggiorni · @Model.EventName</h1>
<partial name="_EventNavigation" model="Model.EventId" />
<p>Quadro riservato agli organizzatori. Arrivo e ultimo giorno inclusi; notti = giorni meno uno. I conteggi comprendono solo presenze confermate con soggiorno completo.</p>
<section class="card card-body mb-4" aria-labelledby="collection-title">
    <h2 id="collection-title" class="h4">Raccolta adesioni</h2>
    @if (Model.Collection.DeadlineLocal is { } deadline)
    {
        <p>Termine: <strong>@deadline.ToString("dd/MM/yyyy HH:mm")</strong> (@Model.Collection.TimeZoneId) · @(Model.Collection.Expired ? "Scaduto" : "Ancora aperto").</p>
    }
    else { <p>Nessun termine impostato.</p> }
    <p>La scadenza è informativa: risposte e correzioni tardive sono sempre ammesse.</p>
    <form asp-action="Deadline" method="post">
        <input type="hidden" name="EventId" value="@Model.EventId" />
        <input type="hidden" name="Revision" value="@Model.Collection.Revision" />
        <label for="deadline-local" class="form-label">Data e ora nel fuso @Model.Collection.TimeZoneId</label>
        <input id="deadline-local" class="form-control mb-2" type="datetime-local" name="DeadlineLocal" value="@Model.Collection.DeadlineLocal?.ToString("yyyy-MM-ddTHH:mm")" />
        <p class="form-text">Lascia vuoto per rimuovere il termine. Le ore ambigue o inesistenti al cambio dell'ora non sono ammesse.</p>
        <div class="form-check mb-2"><input id="deadline-confirm" class="form-check-input" type="checkbox" name="Confirmed" value="true" required /><label for="deadline-confirm" class="form-check-label">Confermo la modifica del termine</label></div>
        <button class="btn btn-primary" type="submit">Salva termine</button>
    </form>
</section>
<section class="card card-body mb-4" aria-labelledby="mode-title">
    <h2 id="mode-title" class="h4">Date della presenza</h2>
    <form asp-action="StayMode" method="post">
        <input type="hidden" name="EventId" value="@Model.EventId" />
        <input type="hidden" name="Revision" value="@Model.Collection.Revision" />
        <div class="form-check mb-2"><input id="ask-dates" class="form-check-input" type="checkbox" name="AskStayDates" value="true" checked="@Model.Collection.AskStayDates" /><label for="ask-dates" class="form-check-label">Chiedi a ogni partecipante data di arrivo e numero di giorni</label></div>
        <p class="form-text">Se disattivato, la presenza vale per la data dell'evento: nel gruppo non vengono chieste né date né notti.</p>
        <label for="event-days" class="form-label">Giorni dell'evento (usati solo se le date non vengono chieste)</label>
        <input id="event-days" class="form-control mb-2" type="number" min="1" max="31" name="EventDays" value="@Model.Collection.EventDays" />
        <div class="form-check mb-2"><input id="mode-confirm" class="form-check-input" type="checkbox" name="Confirmed" value="true" required /><label for="mode-confirm" class="form-check-label">Confermo la modifica</label></div>
        <button class="btn btn-primary" type="submit">Salva modalità</button>
    </form>
</section>
<section class="card card-body mb-4" aria-labelledby="questions-title">
    <h2 id="questions-title" class="h4">Domande aggiuntive</h2>
    <p>Dopo la conferma della presenza, il bot pone queste domande a risposta chiusa (per te e per i bambini collegati). Le domande disattivate non vengono più poste ma conservano le risposte.</p>
    @if (Model.Questions is { Count: > 0 })
    {
        @foreach (var question in Model.Questions)
        {
            <div class="mb-3">
                <h3 class="h5">@question.Text @if (!question.IsActive) { <span class="badge text-bg-secondary">Disattivata</span> }</h3>
                <ul>
                    @foreach (var option in question.Options)
                    {
                        <li><strong>@option.Text</strong> · @option.People.Count@(option.People.Count > 0 ? ": " + string.Join(", ", option.People) : "")</li>
                    }
                </ul>
                <form asp-action="QuestionActive" method="post" class="d-inline">
                    <input type="hidden" name="EventId" value="@Model.EventId" />
                    <input type="hidden" name="QuestionId" value="@question.Id" />
                    <input type="hidden" name="Revision" value="@question.Revision" />
                    <input type="hidden" name="Active" value="@(question.IsActive ? "false" : "true")" />
                    <input type="hidden" name="Confirmed" value="true" />
                    <button class="btn btn-outline-secondary btn-sm" type="submit">@(question.IsActive ? "Disattiva" : "Riattiva")</button>
                </form>
            </div>
        }
    }
    else { <p>Nessuna domanda configurata.</p> }
    <form asp-action="AddQuestion" method="post">
        <input type="hidden" name="EventId" value="@Model.EventId" />
        <label for="question-text" class="form-label">Nuova domanda</label>
        <input id="question-text" class="form-control mb-2" type="text" name="Text" maxlength="200" required placeholder="Come sali alla baita?" />
        <label for="question-options" class="form-label">Risposte possibili, una per riga (da 2 a 8)</label>
        <textarea id="question-options" class="form-control mb-2" name="Options" rows="4" maxlength="600" required placeholder="A piedi&#10;Con il gatto delle nevi"></textarea>
        <div class="form-check mb-2"><input id="question-confirm" class="form-check-input" type="checkbox" name="Confirmed" value="true" required /><label for="question-confirm" class="form-check-label">Confermo l'aggiunta</label></div>
        <button class="btn btn-primary" type="submit">Aggiungi domanda</button>
    </form>
</section>
<section class="mb-4" aria-labelledby="pending-title">
    <h2 id="pending-title" class="h4">Da completare · @Model.Pending.Count</h2>
    @if (Model.Pending.Count == 0) { <p>Tutte le risposte e le date sono complete.</p> }
    else
    {
        <ul>
        @foreach (var person in Model.Pending)
        {
            <li>@person.Name · @(person.Status == ParticipationStatus.Confirmed ? "Soggiorno da completare" : person.Status == ParticipationStatus.Undecided ? "Indeciso" : "Senza risposta")</li>
        }
        </ul>
        <form asp-action="Reminder" method="post">
            <input type="hidden" name="EventId" value="@Model.EventId" />
            <input type="hidden" name="OperationId" value="@Guid.NewGuid()" />
            <button class="btn btn-outline-primary" type="submit">Prepara promemoria WhatsApp</button>
        </form>
        <p class="form-text">Crea una bozza generica senza nomi. Nell'anteprima verifichi il gruppo e confermi l'invio manualmente.</p>
    }
</section>
<p class="form-text">Su schermi piccoli puoi scorrere la tabella orizzontalmente per consultare tutte le date.</p>
<div class="table-responsive" role="region" aria-label="Soggiorni dei partecipanti, tabella scorrevole" tabindex="0"><table class="table">
<thead><tr><th scope="col">Persona</th><th scope="col">Presenza</th><th scope="col">Arrivo</th><th scope="col">Giorni</th><th scope="col">Ultimo giorno</th><th scope="col">Notti</th></tr></thead>
<tbody>
@foreach (var person in Model.People)
{
    var status = person.Status switch { ParticipationStatus.Confirmed => "Confermato", ParticipationStatus.Absent => "Assente", ParticipationStatus.Undecided => "Indeciso", _ => "Senza risposta" };
    <tr><td>@person.Name</td><td>@status</td><td>@(person.Stay?.Arrival.ToString("dd/MM/yyyy") ?? (person.Status == ParticipationStatus.Confirmed ? "Da completare" : "-"))</td><td>@person.Stay?.Days</td><td>@person.Stay?.LastDay.ToString("dd/MM/yyyy")</td><td>@person.Stay?.Nights</td></tr>
}
</tbody></table></div>
<h2 class="h4">Presenze giornaliere</h2>
@if (Model.Days.Count == 0) { <p>Nessun soggiorno confermato completo.</p> }
else
{
    <div class="table-responsive" role="region" aria-label="Presenze giornaliere, tabella scorrevole" tabindex="0"><table class="table"><thead><tr><th scope="col">Giorno</th><th scope="col">Persone</th></tr></thead><tbody>
    @foreach (var day in Model.Days) { <tr><td>@day.Day.ToString("dd/MM/yyyy")</td><td>@day.People</td></tr> }
    </tbody></table></div>
}

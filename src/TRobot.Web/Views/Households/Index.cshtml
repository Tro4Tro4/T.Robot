@model TRobot.Application.Households.HouseholdOverview
@{ ViewData["Title"] = "Nuclei e accompagnatori"; }
<h1>Nuclei e accompagnatori — @Model.Event.Name</h1>
<partial name="_EventNavigation" model="Model.Event.Id" />
<p><a asp-action="Create" asp-route-eventId="@Model.Event.Id">Nuovo nucleo</a> · <a asp-controller="Home" asp-action="Index" asp-route-eventId="@Model.Event.Id">Dashboard</a></p>
<p>Ogni persona può appartenere a un solo nucleo attivo per evento. Senza appartenenza attiva è considerata adulta. Le presenze rimangono individuali.</p>
@if (Model.Households.Count == 0) { <p>Nessun nucleo.</p> }
@foreach (var household in Model.Households)
{
    <h2>@household.Name</h2>
    <p><a asp-action="Rename" asp-route-eventId="@Model.Event.Id" asp-route-householdId="@household.Id">Rinomina nucleo</a></p>
    <p><a asp-action="Add" asp-route-eventId="@Model.Event.Id" asp-route-householdId="@household.Id">Aggiungi partecipante</a></p>
    <div class="table-responsive" role="region" aria-label="Nucleo @household.Name" tabindex="0"><table class="table table-mobile-cards"><thead><tr><th scope="col">Persona</th><th scope="col">Classificazione</th><th scope="col">Accompagnatore di</th><th scope="col">Appartenenza</th><th scope="col">Azioni</th></tr></thead><tbody>
    @foreach (var member in Model.Members.Where(x => x.HouseholdId == household.Id).OrderByDescending(x => x.IsActive))
    {
        var primary = Model.Members.FirstOrDefault(x => x.Id == member.CompanionOfMemberId);
        <tr><td>@Model.People.FirstOrDefault(x => x.Id == member.PersonId)?.Name</td><td>@(member.Kind == TRobot.Domain.HouseholdMemberKind.Adult ? "Adulto" : "Bambino")</td><td>@(Model.People.FirstOrDefault(x => x.Id == primary?.PersonId)?.Name ?? "—")</td><td>@(member.IsActive ? "Attiva" : "Rimossa")</td><td><a asp-action="Edit" asp-route-eventId="@Model.Event.Id" asp-route-id="@member.Id">Modifica</a></td></tr>
    }
    </tbody></table></div>
}

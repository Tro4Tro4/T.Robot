{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build T.Robot",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "src/TRobot.Web",
                "--no-restore"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
